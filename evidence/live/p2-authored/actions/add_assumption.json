{
  "id": "add_assumption",
  "title": "Add assumption",
  "inputs": {
    "id": {"type": "string", "max": 80},
    "alternative": {"type": "string", "max": 80},
    "statement": {"type": "string", "max": 4000},
    "confidence": {"type": "int", "min": 1, "max": 5}
  },
  "requires": [
    {"when": {"not": {"exists": {"record": {"input": "id"}}}}, "reason": "A record with this ID already exists."},
    {"when": {"eq": [{"get": [{"record": {"input": "alternative"}}, "type"]}, {"lit": "alternative"}]}, "reason": "Choose an existing alternative."}
  ],
  "effects": [
    {"create": {"type": "assumption", "id": {"input": "id"}, "fields": {"statement": {"input": "statement"}, "confidence": {"input": "confidence"}}}},
    {"relate": {"relation": "alternative_assumption", "from": {"input": "alternative"}, "to": {"input": "id"}, "fields": {}}}
  ]
}
