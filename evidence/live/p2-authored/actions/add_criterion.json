{
  "id": "add_criterion",
  "title": "Add criterion",
  "inputs": {
    "id": {"type": "string", "max": 80},
    "title": {"type": "string", "max": 200},
    "weight": {"type": "int", "min": 1, "max": 5}
  },
  "requires": [
    {"when": {"not": {"exists": {"record": {"input": "id"}}}}, "reason": "A record with this ID already exists."}
  ],
  "effects": [
    {"create": {"type": "criterion", "id": {"input": "id"}, "fields": {"title": {"input": "title"}, "weight": {"input": "weight"}}}}
  ]
}
