{
  "id": "evidence",
  "title": "Measured results",
  "kind": "table",
  "empty": "Attach evidence with basis measured to every alternative.",
  "rows": {"filter": {"list": {"records": "evidence"}, "as": "e", "where": {"eq": [{"get": [{"var": "e"}, "basis"]}, {"lit": "measured"}]}}},
  "columns": [
    {"label": "Result", "value": {"get": [{"var": "row"}, "title"]}},
    {"label": "Kind", "value": {"get": [{"var": "row"}, "kind"]}},
    {"label": "Stance", "value": {"get": [{"var": "row"}, "stance"]}},
    {"label": "Alternative", "value": {"map": {"list": {"filter": {"list": {"records": "alternative"}, "as": "a", "where": {"gt": [{"len": {"related": {"relation": "alternative_evidence", "from": {"get": [{"var": "a"}, "id"]}, "to": {"get": [{"var": "row"}, "id"]}}}}, {"lit": 0}]}}}, "as": "a", "to": {"get": [{"var": "a"}, "title"]}}}}
  ]
}
